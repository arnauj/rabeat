# Copia este archivo a supabase/.env, rellénalo y ejecuta: npm run supabase:secrets
# (supabase/.env no se sube a GitHub)

# URL pública de la web (para enlaces en los emails y vuelta desde Stripe)
SITE_URL=https://www.rabeat.eu/

# Emails: Resend (resend.com, dominio rabeat.eu verificado). Tiene prioridad sobre SMTP.
RESEND_API_KEY=
MAIL_FROM=rabeat <noreply@rabeat.eu>

# Alternativa SMTP (p. ej. Gmail con contraseña de aplicación, puerto 465)
SMTP_USER=
SMTP_PASS=

# Stripe (dashboard.stripe.com → Desarrolladores → Claves de API / Webhooks)
# Mientras estén vacías, los pagos con tarjeta se simulan (modo pruebas).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Métodos de pago online (separados por comas). «card» incluye Apple Pay y Google Pay.
# PayPal y Bizum deben estar activados en Stripe → Configuración → Métodos de pago antes de ofrecerlos
# (Bizum está en vista previa: hay que solicitar el acceso a Stripe).
STRIPE_PAYMENT_METHODS=card,paypal,bizum
